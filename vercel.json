{
  "installCommand": "python -m pip install -r requirements-vercel.txt",
  "functions": {
    "main.py": {
      "excludeFiles": "{.venv/**,.vercel/**,.tmp*/**,.opencode/**,build/**,tests/**,data/**,TRANSCRIPTS/**,MATCH*/**,CLIP*/**,CAPTIONS/**,THUMB*/**,TOP*/**,TRACKING/**,outputs/**,planning/**,docs/**,FootballArchive/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/main.py"
    }
  ],
  "env": {
    "CLIPPER_ENV": "demo"
  }
}
