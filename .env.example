# Clipper / Stadium Signal environment configuration.
# Variable names only — no secrets. Copy to `.env` and fill in locally.

# ── Core ─────────────────────────────────────────────────────────────────────
# Optional archive root override. Defaults to C:\FootballArchive on Windows and
# FootballArchive/ on macOS/Linux.
FOOTBALL_ARCHIVE_ROOT=

# ── OpenAI / model backends ──────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Text model for clip detection
DEFAULT_OPENAI_MODEL=gpt-4.1
# Text model for Claude detection
DEFAULT_CLAUDE_MODEL=claude-3-5-sonnet-latest
# Audio model for transcription (used by OpenAI provider)
DEFAULT_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Model size for local faster-whisper (base, small, medium, large-v3)
DEFAULT_WHISPER_MODEL=base

# Ollama endpoint for local clip detection
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1

# ── Model providers ──────────────────────────────────────────────────────────
# Story and Edit Brief generation providers. Allowed: openai | ollama
# STORY_PROVIDER defaults to openai. EDIT_PROVIDER defaults to STORY_PROVIDER.
STORY_PROVIDER=openai
EDIT_PROVIDER=openai

# ── Research provider ────────────────────────────────────────────────────────
# Optional production research boundary. Allowed V1 value: wikipedia/external.
# If unset, Clipper reports research provider NOT_CONFIGURED and can still use
# fixture/import research in tests or manual workflows.
RESEARCH_PROVIDER=
RESEARCH_PROVIDER_TIMEOUT=8
RESEARCH_PROVIDER_USER_AGENT=ClipperResearch/1.0

# Optional per-stage Ollama model overrides (fall back to OLLAMA_MODEL).
OLLAMA_STORY_MODEL=
OLLAMA_EDIT_MODEL=

# ── Runtime overrides ────────────────────────────────────────────────────────
# Runtime SQLite index location (default: data/pilot/runtime.sqlite3)
STADIUM_RUNTIME_DB=
# Pre-migration backup directory (default: data/pilot/backups)
STADIUM_RUNTIME_BACKUPS=
# Pilot job/intake records root (default: data/pilot)
STADIUM_PILOT_JOBS_DIR=

# ── Optional integrations (never required for core operation) ───────────────
OORT_API_KEY=
OORT_BUCKET=
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
SLACK_WEBHOOK_URL=

# ── Legacy ───────────────────────────────────────────────────────────────────
# Legacy account positioning fallback. Only used when account_positioning is
# absent from config/pipeline_config.json.
ACCOUNT_POSITIONING=America Discovers Football
