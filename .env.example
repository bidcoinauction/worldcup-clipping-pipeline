OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional archive root override. Defaults to C:\FootballArchive on Windows and FootballArchive/ on macOS/Linux.
FOOTBALL_ARCHIVE_ROOT=

# Text model for clip detection
DEFAULT_OPENAI_MODEL=gpt-4.1

# Text model for Claude detection
DEFAULT_CLAUDE_MODEL=claude-3-5-sonnet-latest

# Audio model for transcription (used by OpenAI provider)
DEFAULT_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Model size for local faster-whisper (base, small, medium, large-v3)
DEFAULT_WHISPER_MODEL=base

# Ollama endpoint for local clip detection
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1

# Legacy account positioning fallback. Only used when account_positioning is
# absent from config/pipeline_config.json; explicit config always wins.
ACCOUNT_POSITIONING=America Discovers Football
