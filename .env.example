OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional archive root override. Defaults to C:\FootballArchive on Windows and FootballArchive/ on macOS/Linux.
FOOTBALL_ARCHIVE_ROOT=

# Text model for clip detection
DEFAULT_OPENAI_MODEL=gpt-4.1

# Text model for Claude detection
DEFAULT_CLAUDE_MODEL=claude-3-5-sonnet-latest

# Audio model for transcription (used by OpenAI provider)
DEFAULT_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Model size for local faster-whisper (base, small, medium, large-v3)
DEFAULT_WHISPER_MODEL=base

# Ollama endpoint for local clip detection
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1

# Legacy account positioning fallback. Only used when account_positioning is
# absent from config/pipeline_config.json; explicit config always wins.
ACCOUNT_POSITIONING=America Discovers Football

# ── OORT Storage (Phase 7.1, optional) ───────────────────────────────────────
# Opt-in, private-by-default object storage for verified local-ingest artifacts.
# Leave blank to keep the pipeline fully local: uploads are skipped and the run
# continues. Create access keys at https://console.oortech.com (Access Keys).
# Never commit real values; put them in a local .env that is not tracked.
OORT_ACCESS_KEY_ID=
OORT_SECRET_ACCESS_KEY=
# S3-compatible gateway (HTTPS-only, port 443). Standard or archive:
#   https://s3-standard.oortech.com  (default)
#   https://s3-archive.oortech.com
OORT_ENDPOINT=https://s3-standard.oortech.com
# SigV4 region expected by OORT (default: us-east-1).
OORT_REGION=us-east-1
# Target bucket (3-63 chars, lowercase letters/numbers/dashes, globally unique).
OORT_BUCKET=
# Optional storage class header (leave blank for the default class).
OORT_STORAGE_CLASS=
